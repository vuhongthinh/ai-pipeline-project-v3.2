# ===== Bắt buộc =====
# docker compose sẽ từ chối chạy nếu thiếu 2 biến mật khẩu dưới đây.
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-another-long-random-value

# ===== Mô hình AI (mặc định nhẹ cho laptop CPU-only) =====
# Text: llama3.2:1b (~1.3GB). Máy mạnh hơn: llama3.2:3b, qwen2.5:3b...
# Lưu ý: llama3.2 thiên tiếng Anh, tiếng Việt không nằm trong danh sách
# ngôn ngữ chính thức - cần bộ mẫu tự đánh giá trước khi tin kết quả.
OLLAMA_TEXT_MODEL=llama3.2:1b
# Vision: moondream (~1.7GB). Máy mạnh hơn: llava:7b, qwen2.5vl:3b, gemma3:4b...
OLLAMA_VISION_MODEL=moondream
# Ngữ cảnh LLM: tiếng Việt tốn token, để nhỏ quá prompt bị cắt ngầm.
# Giảm còn 4096 nếu RAM ít; tăng 8192+ khi dùng model 3b trở lên.
OLLAMA_NUM_CTX=8192
# Bao lâu thì giải phóng model khỏi RAM sau khi rảnh (laptop CPU: ngắn = đỡ RAM).
OLLAMA_KEEP_ALIVE=5m

# Whisper: "base" nhanh trên CPU nhưng yếu tiếng Việt; "small" trở lên chất
# lượng hơn nếu chấp nhận chậm. Đặt WHISPER_LANGUAGE= (rỗng) để tự dò.
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi

# ===== Kích thước tệp =====
# Giới hạn ảnh (bytes) trước khi base64 hóa
MAX_IMAGE_SIZE=10485760

# ===== Truy cập MinIO từ trình duyệt =====
# Presigned URL được KÝ bằng địa chỉ mà trình duyệt người dùng truy cập
# (chữ ký SigV4 tính cả Host). Mặc định localhost:9000 khi mở dashboard từ
# chính máy chạy Docker; đổi thành IP/hostname của máy Docker nếu xem từ máy khác.
MINIO_PUBLIC_URL=localhost:9000

# ===== Bảo mật tuỳ chọn =====
# Đặt giá trị khác rỗng để bật xác thực X-API-Key cho /upload.
# Lưu ý: khi bật, giao diện web tại / (fetch trình duyệt) sẽ không upload được
# trực tiếp vì không gửi được header - dùng cho caller kiểu bot/CI.
API_KEY=
