FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# ffmpeg vẫn cần để whisper đọc nhiều định dạng audio.
COPY requirements-whisper.txt .
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements-whisper.txt

COPY whisper_service.py .

# Cache model whisper nằm trong XDG_CACHE_HOME của user thường.
ENV XDG_CACHE_HOME=/app/.cache
RUN useradd --create-home --uid 1000 appuser && mkdir -p /app/.cache/whisper && chown -R appuser /app
USER appuser

EXPOSE 8888
CMD ["uvicorn", "whisper_service:app", "--host", "0.0.0.0", "--port", "8888"]
